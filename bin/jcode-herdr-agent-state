#!/usr/bin/env bash
# Integracao Jcode <-> herdr.
#
# Reporta estado semantico do agente (working/idle) e o titulo da sessao para o
# herdr, usando os hooks de ciclo de vida do Jcode. No-op fora do herdr.
#
# Configure em ~/.jcode/config.toml:
#   [hooks]
#   session_start = "~/.local/bin/jcode-herdr-agent-state"
#   session_end   = "~/.local/bin/jcode-herdr-agent-state"
#   turn_end      = "~/.local/bin/jcode-herdr-agent-state"
#   post_tool     = "~/.local/bin/jcode-herdr-agent-state"
set -euo pipefail

[[ "${HERDR_ENV:-}" == "1" ]] || exit 0
[[ -n "${HERDR_PANE_ID:-}" ]] || exit 0
HERDR="${HERDR_BIN_PATH:-herdr}"
command -v "$HERDR" >/dev/null 2>&1 || exit 0

SOURCE="custom:jcode"
AGENT="jcode"
SEQ_FILE="${TMPDIR:-/tmp}/jcode-herdr-seq.${HERDR_PANE_ID//:/_}"

next_seq() {
  local n=0
  [[ -f "$SEQ_FILE" ]] && n=$(cat "$SEQ_FILE" 2>/dev/null || echo 0)
  n=$((n + 1))
  printf '%s' "$n" > "$SEQ_FILE"
  printf '%s' "$n"
}

report() {  # $1 = state, $2 = message opcional
  local args=(pane report-agent "$HERDR_PANE_ID"
              --source "$SOURCE" --agent "$AGENT" --state "$1"
              --seq "$(next_seq)")
  [[ -n "${2:-}" ]] && args+=(--message "$2")
  [[ -n "${JCODE_HOOK_SESSION_ID:-}" ]] && args+=(--agent-session-id "$JCODE_HOOK_SESSION_ID")
  "$HERDR" "${args[@]}" >/dev/null 2>&1 || true
}

case "${JCODE_HOOK_EVENT:-}" in
  session_start)
    report working "sessao iniciada"
    ;;
  pre_tool|post_tool)
    report working "${JCODE_HOOK_TOOL_NAME:-tool}"
    ;;
  turn_end)
    if [[ "${JCODE_HOOK_STATUS:-ok}" == "ok" ]]; then
      report idle
    else
      report blocked "${JCODE_HOOK_ERROR:-erro no turno}"
    fi
    ;;
  session_end)
    "$HERDR" pane release-agent "$HERDR_PANE_ID" \
      --source "$SOURCE" --agent "$AGENT" >/dev/null 2>&1 || true
    rm -f "$SEQ_FILE"
    ;;
esac

# pre_tool e' um gate: sempre liberar.
exit 0
