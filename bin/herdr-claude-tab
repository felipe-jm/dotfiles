#!/usr/bin/env bash
# Cria uma aba herdr rodando o Claude Code, sem perguntar nada.
# A aba nasce com o label "claude";
# o herdr detecta o agente sozinho (kind "claude") e mostra o estado na sidebar.
set -euo pipefail

herdr="${HERDR_BIN_PATH:-herdr}"
cwd="${HERDR_ACTIVE_PANE_CWD:-$PWD}"

out=$("$herdr" tab create --cwd "$cwd" --label claude --focus)
pane=$(printf '%s' "$out" | python3 -c 'import json,sys;print(json.load(sys.stdin)["result"]["root_pane"]["pane_id"])')

"$herdr" pane send-text "$pane" 'clear; claude --dangerously-skip-permissions' >/dev/null
"$herdr" pane send-keys "$pane" enter >/dev/null

# O nome definitivo da aba vem do herdr-claude-autoname (titulo Haiku do
# session-title.py, ou o titulo OSC do Claude Code enquanto o hook nao roda).
~/.local/bin/herdr-claude-autoname --ensure-daemon >/dev/null 2>&1 || true
