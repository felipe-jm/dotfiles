#!/usr/bin/env python3
"""Alterna para a ultima aba usada no herdr (MRU), igual Ctrl+Tab do Dia.

  herdr-tab-mru --daemon          escuta tab_focused/workspace_focused e grava a pilha MRU
  herdr-tab-mru --ensure-daemon   sobe o daemon se nao estiver rodando
  herdr-tab-mru --toggle          foca a aba anterior (sobe o daemon se preciso)

Bind: Ghostty ctrl+tab -> ctrl+b ; -> [[keys.command]] prefix+semicolon.
Apertar de novo volta, porque o proprio foco empurra a aba para o topo da pilha.
Vale entre workspaces, como abas do browser.
"""
import json
import os
import socket
import subprocess
import sys
import time

HERDR = os.environ.get("HERDR_BIN_PATH", "herdr")
SOCK = os.path.expanduser("~/.config/herdr/herdr.sock")
STATE_DIR = os.path.expanduser("~/.local/state/herdr-tab-mru")
STACK = os.path.join(STATE_DIR, "stack.json")
PID = os.path.join(os.environ.get("TMPDIR", "/tmp"), "herdr-tab-mru.pid")
MAX = 50


def snapshot():
    out = json.loads(subprocess.check_output([HERDR, "api", "snapshot"]))
    return out.get("result", out)["snapshot"]


def load():
    try:
        with open(STACK) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return []


def save(stack):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = STACK + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(stack[:MAX], fh)
    os.replace(tmp, STACK)


def push(tab_id):
    if not tab_id:
        return
    stack = [t for t in load() if t != tab_id]
    save([tab_id] + stack)


def daemon():
    with open(PID, "w") as fh:
        fh.write(str(os.getpid()))
    try:
        push(snapshot().get("focused_tab_id"))
        sock = socket.socket(socket.AF_UNIX)
        sock.connect(SOCK)
        subs = [{"type": t} for t in ("tab.focused", "workspace.focused", "tab.closed")]
        req = {"id": "mru", "method": "events.subscribe", "params": {"subscriptions": subs}}
        sock.sendall((json.dumps(req) + "\n").encode())
        for line in sock.makefile():
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            kind, data = ev.get("event"), ev.get("data") or {}
            if kind == "tab_focused":
                push(data.get("tab_id"))
            elif kind == "workspace_focused":
                # troca de workspace nem sempre emite tab_focused: pega a aba ativa
                try:
                    push(snapshot().get("focused_tab_id"))
                except (subprocess.CalledProcessError, OSError, ValueError, KeyError):
                    pass
            elif kind == "tab_closed":
                save([t for t in load() if t != data.get("tab_id")])
    finally:
        try:
            os.remove(PID)
        except OSError:
            pass


def running():
    try:
        with open(PID) as fh:
            os.kill(int(fh.read().strip()), 0)
        return True
    except (OSError, ValueError):
        return False


def ensure_daemon():
    if running():
        return False
    subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "--daemon"],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    return True


def toggle():
    if ensure_daemon():
        time.sleep(0.3)
    snap = snapshot()
    current = snap.get("focused_tab_id")
    alive = {t["tab_id"] for t in snap.get("tabs", [])}
    stack = [t for t in load() if t in alive]
    target = next((t for t in stack if t != current), None)
    if target:
        subprocess.run([HERDR, "tab", "focus", target], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "--toggle"
    if cmd == "--daemon":
        daemon()
    elif cmd == "--ensure-daemon":
        ensure_daemon()
    elif cmd == "--toggle":
        toggle()
    else:
        sys.exit("uso: herdr-tab-mru [--toggle|--daemon|--ensure-daemon]")
